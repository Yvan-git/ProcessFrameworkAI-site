# The Collabior Process Framework — a single-page application.
#
# Every route (the map, the documents, governance, the chat) is served by the
# same shell; the browser routes from there. The data lives in /framework/.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve the shell for any path that is not a real file.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /200.html [L]
</IfModule>

# Hashed assets never change under the same name.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/json "access plus 5 minutes"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
